# ==========================================================================
# Configuración del backup de OdontoCampus
#
#   sudo cp backup.env.example /opt/supabase/backup.env
#   sudo nano /opt/supabase/backup.env
#   sudo chmod 600 /opt/supabase/backup.env
#
# Este archivo NO va al repositorio.
# ==========================================================================

# --- Cifrado (obligatorio: el script aborta sin uno de los dos) ------------
#
# El paquete contiene las notas de los estudiantes y todos los secretos del
# servidor. Sin cifrar no sale de la máquina.
#
# Opción A (recomendada): clave pública GPG. La clave privada vive en la
# computadora de quien administra, no en el servidor. Si alguien entra al
# servidor, no puede leer los backups viejos.
GPG_RECIPIENT=

# Opción B: contraseña simétrica. Más simple, pero la contraseña está en el
# servidor: quien entre puede descifrar todo. Guardala también en el gestor
# compartido, o el backup no sirve para nada.
BACKUP_PASSPHRASE=

# --- Copia fuera del servidor ----------------------------------------------
#
# Configurar antes con:  rclone config
# Backblaze B2 sale alrededor de un dólar por mes a este volumen.
#
# Sin esto, el backup vive en la misma máquina que protege: no sirve para el
# caso más probable, que es perder el servidor entero.
RCLONE_REMOTE=b2:odontocampus-backups

# --- Opcionales -------------------------------------------------------------
SUPABASE_DIR=/opt/supabase
DESTINO_LOCAL=/var/backups/odontocampus
RETENCION_DIAS=14
