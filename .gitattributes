# ==========================================================================
# OdontoCampus — normalización de fin de línea
#
# Se trabaja en Windows y se despliega en Linux. Sin esto, git guarda los
# archivos con CRLF y en el servidor pasa lo siguiente:
#
#   $ ./backup.sh
#   bash: ./backup.sh: /usr/bin/env: bad interpreter: No such file or directory
#
# El error no menciona los fines de línea por ningún lado, así que se pierde
# un buen rato buscando en el lugar equivocado. Lo mismo vale para los .sql,
# los .yml y los archivos de configuración de nginx.
# ==========================================================================

# Todo texto se guarda en el repositorio con LF
* text=auto eol=lf

# Explícito para lo que se ejecuta en el servidor
*.sh      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf

# Lo que sí es de Windows
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binarios: que git no los toque
*.jpg     binary
*.jpeg    binary
*.png     binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.pdf     binary
